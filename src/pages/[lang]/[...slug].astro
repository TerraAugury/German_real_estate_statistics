---
import Base from '../../layouts/Base.astro';
import KpiView from '../../components/KpiView.astro';
import KpiPanel from '../../components/KpiPanel.astro';
import { built, langs, slug, href, type Lang, type BuiltPage } from '../../lib/routes';
import { t, fmt } from '../../lib/i18n';
import { sparkline } from '../../lib/chart';
import { notesFor } from '../../lib/notes';
import { loadManifest } from '../../lib/manifest';
import { readProse, unreviewedProse, DRAFT } from '../../lib/review';
import { sourcesTable } from '../../lib/sources';
import { compactChart, latestBlock, renderHero, renderInsight, renderInsightIndex, renderToneLegend, sourceBlock } from '../../lib/panel';
import { KPIS, SEGMENTS, SEGMENT_PAGES, cell, naText, viewHref, type GeoGroup, type Segment } from '../../lib/kpis';
import { availability, firstSeries, homeIndex, kpiPage, linksOverview } from '../../lib/pages';
import { insightsPage, leadInsight } from '../../lib/insights';

export function getStaticPaths() {
  return langs.flatMap((lang) => built.map((page) => ({ params: { lang, slug: slug(page, lang) || undefined }, props: { page } })));
}
const { lang } = Astro.params as { lang: Lang };
const { page } = Astro.props as { page: BuiltPage };

// KPI page: every selector state rendered, the script shows the one the URL asks for (spec section 8).
const kpi = KPIS.find((k) => k.page === page);
const model = kpi ? kpiPage(kpi) : undefined;
const views = model?.views ?? [];
const panels = model?.panels ?? [];
const overview = page === 'links' ? linksOverview() : undefined;
const insights = page === 'insights' ? insightsPage() : [];
const homeRows = page === 'home' ? homeIndex() : [];
// Home opens with one Insight when any is shown; otherwise it opens with the index.
const lead = page === 'home' ? leadInsight() : undefined;
const prose = import.meta.glob<{ Content: any }>('../../../content/*/*.md', { eager: true });
// Prose pages: content/<lang>/<page key>.md (the Impressum is legal-notice.md in both languages).
const Prose = prose[`../../../content/${lang}/${page}.md`]?.Content;
const proseDraft = lang === 'de' && unreviewedProse(readProse()).includes(page);
// Germany-wide geographies have no optgroup on the selector; the Availability grid names them "Germany".
const selectorGroup: Record<GeoGroup, string | null> = { germany: null, city_classes: 'select.city_classes', laender: 'select.laender' };
const coverGroup: Record<GeoGroup, string> = { germany: 'geo.germany', city_classes: 'select.city_classes', laender: 'select.laender' };
const segment = page.startsWith('segment-') ? (page.slice('segment-'.length) as Segment) : null;
const title = kpi ? t(lang, kpi.title) : segment ? t(lang, `segment.${segment}`)
  : t(lang, `${page === 'home' ? 'site' : page}.title`);
// Segment pages show the first series of a view as a compact chart; Home lists each KPI as an index row.
---
<Base lang={lang} page={page} title={title}>
  {(kpi || segment) && <nav class="crumbs" aria-label={t(lang, 'nav.breadcrumb')}><a href={href('home', lang)}>{t(lang, 'nav.home')}</a> › {title}</nav>}
  {page === 'home' ? (
    <>
      <h1 class="vh">{t(lang, 'site.title')}</h1>
      <p>{t(lang, 'home.purpose')}</p>
      {lead && <Fragment set:html={renderHero(lead.entry, lead.result, lead.series, lang)} />}
      <ul class="index">
        {homeRows.map(({ kpi: k, view: v, series: x }) => (
          <li class="row">
            <a class="name" href={v ? viewHref(k, v, lang) : href(k.page, lang)}>{t(lang, k.title)}</a>
            {x && v ? (
              <>
                <Fragment set:html={latestBlock(x, lang)} />
                <Fragment set:html={sparkline(x, lang)} />
                <span class="what">{x.title[lang]}</span>
                {notesFor(x, lang, { on: 'compact' }).map((n) => <p class="note">{n}</p>)}
                <div class="src"><Fragment set:html={sourceBlock(x, lang)} /></div>
              </>
            ) : <p class="na">{t(lang, 'kpi.not_available.licence')}</p>}
          </li>
        ))}
      </ul>
      <h2>{t(lang, 'home.segments')}</h2>
      <ul>{SEGMENT_PAGES.map((g) => <li><a href={href(`segment-${g}`, lang)}>{t(lang, `segment.${g}`)}</a></li>)}</ul>
    </>
  ) : segment ? (
    <>
      <h1>{title}</h1>
      <p>{t(lang, 'segment.intro')}</p>
      {KPIS.map((k) => {
        const c = cell(k, segment);
        if (!('view' in c)) return <section><h2>{t(lang, k.title)}</h2><p class="na">{naText(c, lang)}</p></section>;
        const x = firstSeries(c.view);
        return (
          <section>
            <h2><a href={viewHref(k, c.view, lang)}>{t(lang, k.title)}</a></h2>
            <figure><h3>{x.title[lang]}</h3><Fragment set:html={compactChart(x, lang)} /></figure>
          </section>
        );
      })}
      <p><a href={href('availability', lang)}>{t(lang, 'segment.availability')}</a></p>
    </>
  ) : page === 'availability' ? (
    <>
      <h1>{title}</h1>
      <p>{t(lang, 'availability.intro')}</p>
      <div class="scroll"><table>
        <thead><tr><th scope="col">{t(lang, 'availability.kpi')}</th>{SEGMENTS.map((g) => <th scope="col">{t(lang, `segment.${g}`)}</th>)}</tr></thead>
        <tbody>{availability().map(({ kpi: k, cells }) => (
          <tr><th scope="row"><a href={href(k.page, lang)}>{t(lang, k.title)}</a></th>{cells.map(({ cell: c, geos }) => {
            if (!('view' in c)) return <td class={c.na === 'licence' ? 'na licence' : 'na'}>{naText(c, lang)}</td>;
            const geo = geos.map((g) => t(lang, coverGroup[g])).join(', ');
            return <td class="yes"><a href={viewHref(k, c.view, lang)}>{t(lang, 'availability.available', { geo })}</a></td>;
          })}</tr>
        ))}</tbody>
      </table></div>
    </>
  ) : page === 'links' ? (
    <>
      <h1>{title}</h1>
      <p>{t(lang, 'links.intro')}</p>
      <div class="legend" aria-hidden="true"><i class="ramp"></i></div>
      <p class="scale"><span>{t(lang, 'links.scale.neg')}</span><span>{t(lang, 'links.scale.zero')}</span><span>{t(lang, 'links.scale.pos')}</span></p>
      <p class="note">{t(lang, 'links.legend')}</p>
      <p class="note">{t(lang, 'links.noise.legend')}</p>
      <div class="selectors"><label>{t(lang, 'links.lag.label')}<select id="lag">{[0, 1, 2].map((y) => <option value={y}>{t(lang, `links.lag.${y}`)}</option>)}</select></label></div>
      <div class="scroll"><table class="matrix" data-lag="0">
        <thead><tr><th scope="col">{t(lang, 'availability.kpi')}</th>{overview!.columns.map((n) => <th scope="col">{t(lang, `indicator.${n}`)}</th>)}</tr></thead>
        <tbody>{overview!.rows.map(({ kpi: k, view: v, cells }) => (
          <tr>
            <th scope="row"><a href={href(k.page, lang)}>{t(lang, k.title)}</a>{v && <><br /><small>{firstSeries(v).title[lang]}</small></>}</th>
            {!v ? <td class="na licence" colspan={overview!.columns.length}>{t(lang, 'kpi.not_available.licence')}</td> : overview!.columns.map((n) => {
              const c = cells.get(n);
              if (!c) return <td />;
              const r = c.result;
              const to = `${viewHref(k, v, lang)}#${c.pair.id}`;
              // One link per lag; the selector shows one. A shown Link is shaded by its rho, with the coefficient first and n
              // beneath; one not shown (or under the minimum overlap at that lag) is hatched like any gap.
              return <td class="lagcell">{c.lags.map((l, y) => l.heat && l.rho !== null
                ? <a data-lag={y} href={to} class={`${l.heat.side}${l.noise ? ' noise' : ''}`} style={`--share: ${l.heat.share}%`}><span class="rho">{fmt(lang, l.rho, { maximumFractionDigits: 2 })}</span><span class="n">{t(lang, 'links.cell.n', { n: String(l.n) })}</span>{c.pair.preset && <span class="preset">{t(lang, 'links.cell.preset')}</span>}</a>
                : <a data-lag={y} href={to} class="na">{t(lang, 'links.cell.not_shown', { n: String(l.n) })}{c.pair.preset && <span class="preset">{t(lang, 'links.cell.preset')}</span>}</a>)}</td>;
            })}
          </tr>
        ))}</tbody>
      </table></div>
      <p class="note">{t(lang, 'links.preset.note')}</p>
      <script>
        import { lagFromHash } from '../../lib/select';
        const sel = document.querySelector<HTMLSelectElement>('#lag')!;
        const table = document.querySelector<HTMLTableElement>('table.matrix')!;
        const apply = () => { table.dataset.lag = sel.value; };
        sel.value = String(lagFromHash(location.hash));
        apply();
        // The view is shareable: #lag-1 / #lag-2, no hash for same year.
        sel.addEventListener('change', () => { apply(); history.replaceState(null, '', sel.value === '0' ? location.pathname + location.search : '#lag-' + sel.value); });
      </script>
    </>
  ) : page === 'insights' ? (
    <>
      <h1>{title}</h1>
      {insights.length === 0 ? <p>{t(lang, 'insights.empty')}</p> : (
        <>
          <p>{t(lang, 'insights.intro')}</p>
          <Fragment set:html={renderToneLegend(lang)} />
          <nav class="jump" id="index" aria-label={t(lang, 'insights.jump')}>
            <h2>{t(lang, 'insights.jump')}</h2>
            <Fragment set:html={renderInsightIndex(insights, lang)} />
          </nav>
          {insights.map(({ entry, series, result }) => <Fragment set:html={renderInsight(entry, result, series, lang)} />)}
        </>
      )}
    </>
  ) : Prose ? (
    <>
      <h1>{title}</h1>
      {proseDraft && <p class="note">{DRAFT.trim()}</p>}
      <Prose />
    </>
  ) : page === 'sources' ? (
    <>
      <h1>{title}</h1>
      <p>{t(lang, 'sources.intro')}</p>
      <div class="scroll"><Fragment set:html={sourcesTable(loadManifest(), lang)} /></div>
    </>
  ) : (
    <>
      <h1>{title}</h1>
      {views.length === 0 ? <p class="na">{t(lang, 'kpi.not_available.licence')}</p> : (
        <>
          {/* Without JavaScript the selectors cannot switch views: hide them and say so. */}
          <noscript><style>.selectors { display: none; }</style><p class="note">{t(lang, 'kpi.noscript')}</p></noscript>
          <form class="selectors">
            <label>{t(lang, 'select.segment')} <select name="segment">{model!.selectors.segment.map((x) => <option value={x}>{t(lang, `segment.${x}`)}</option>)}</select></label>
            <label>{t(lang, 'select.geo')} <select name="geo">{model!.selectors.geo.map((g) => {
              const opts = g.geos.map((x) => <option value={x}>{t(lang, `geo.${x}`)}</option>);
              const label = selectorGroup[g.group];
              return label ? <optgroup label={t(lang, label)}>{opts}</optgroup> : opts;
            })}</select></label>
            <label>{t(lang, 'select.freq')} <select name="freq">{model!.selectors.freq.map((x) => <option value={x}>{t(lang, `freq.${x}`)}</option>)}</select></label>
          </form>
          {/* Only the first view is in the page; each other waits as an empty marker the script fills from its fragment. */}
          {views.map(({ view: v, links, live }, i) => live
            ? <KpiView view={v} links={links} lang={lang} />
            : <template class="view" data-segment={v.segment} data-geo={v.geo} data-freq={v.freq} data-links={links.join(' ')} data-src={`/${lang}/fragments/${page}/${i}/`}></template>)}
          {panels.length > 0 && (
            <>
              <h2>{t(lang, 'links.heading')}</h2>
              <div id="panels">{panels.map((p, order) => p.live && <KpiPanel panel={p} order={order} lang={lang} />)}</div>
            </>
          )}
          {model!.insights.length > 0 && (
            <section>
              <h2>{t(lang, 'kpi.insights.heading')}</h2>
              <ul>{model!.insights.map((e) => <li><a href={`${href('insights', lang)}#${e.key}`}>{e.title[lang]}</a></li>)}</ul>
            </section>
          )}
          <script>
            import { pickView, type Want } from '../../lib/select';
            const form = document.querySelector<HTMLFormElement>('form.selectors')!;
            // Page weight (ticket 12): the page holds the first view and its panels. Every other view is an empty
            // <template> marker with the URL of its fragment; the first time it is picked its section and panels are
            // fetched and move into the page, and from then on it only hides and shows.
            const views = [...document.querySelectorAll<HTMLElement>('section.view, template.view')].map((el) => ({ el, ...(el.dataset as Want), src: el.dataset.src }));
            const panels = new Map([...document.querySelectorAll<HTMLElement>('[data-panel]')].map((el) => [el.dataset.panel!, el]));
            const keys = ['segment', 'geo', 'freq'] as const;
            const load = async (v: (typeof views)[number]) => {
              if (!v.src) return;
              const res = await fetch(v.src);
              if (!res.ok) throw new Error(v.src);
              const box = document.createElement('div');
              box.innerHTML = await res.text();
              const section = box.querySelector<HTMLElement>('section.view')!;
              section.hidden = true;
              v.el.replaceWith(section);
              v.el = section;
              v.src = undefined;
              // Panels keep the page's order: each goes before the first held panel that comes after it.
              for (const p of box.querySelectorAll<HTMLElement>('[data-panel]')) {
                if (panels.has(p.dataset.panel!)) continue;
                p.hidden = true;
                const next = [...panels.values()].find((q) => +q.dataset.order! > +p.dataset.order!);
                next ? next.before(p) : document.getElementById('panels')!.append(p);
                panels.set(p.dataset.panel!, p);
              }
            };
            let shown = views[0], latest = 0;
            // Show the closest view and its Link panels; the URL and the language switch then name exactly that view.
            const show = async (want: Partial<Want>, changed?: keyof Want) => {
              const v = pickView(views, want, changed);
              const turn = ++latest;
              const loaded = await load(v).then(() => true, () => false);
              if (turn !== latest) return;
              const target = loaded ? v : shown; // a failed fetch keeps the view on screen
              for (const x of views) x.el.hidden = x !== target;
              const ids = target.el.dataset.links!.split(' ');
              for (const [id, el] of panels) el.hidden = !ids.includes(id);
              shown = target;
              for (const k of keys) (form.elements.namedItem(k) as HTMLSelectElement).value = target[k];
              history.replaceState(null, '', '?' + new URLSearchParams({ segment: target.segment, geo: target.geo, freq: target.freq }) + location.hash);
              document.querySelector<HTMLAnchorElement>('a.sw')!.search = location.search;
            };
            const q = new URLSearchParams(location.search);
            if (keys.some((k) => q.has(k))) await show(Object.fromEntries(keys.flatMap((k) => (q.has(k) ? [[k, q.get(k)!]] : []))));
            // A Links overview cell names a panel that was hidden at load, so the browser could not scroll to it.
            if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView();
            form.addEventListener('change', (e) => show(Object.fromEntries(new FormData(form)) as Want, (e.target as HTMLSelectElement).name as keyof Want));
          </script>
        </>
      )}
    </>
  )}
</Base>
