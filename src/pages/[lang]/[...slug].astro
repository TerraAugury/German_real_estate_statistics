---
import Base from '../../layouts/Base.astro';
import { built, langs, slug, href, type Lang, type PageKey } from '../../lib/routes';
import { t, fmt } from '../../lib/i18n';
import { loadSeries } from '../../lib/series';
import { lineChart } from '../../lib/chart';
import { notes } from '../../lib/notes';

export function getStaticPaths() {
  return langs.flatMap((lang) => built.map((page) => ({ params: { lang, slug: slug(page, lang) || undefined }, props: { page } })));
}
const { lang } = Astro.params as { lang: Lang };
const { page } = Astro.props as { page: PageKey };
const s = loadSeries('construction-permits-office');
const last = s.points.at(-1)!;
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const sourceLine = t(lang, 'source.line', {
  publisher: esc(s.publisher), id: `<a href="${s.dbnomicsUrl}">${esc(s.dbnomicsId)}</a>`,
  licence: `<a href="${s.licence.url}">${esc(s.licence.name)}</a>`, period: s.lastPeriod })
  + (s.derived ? ` / ${t(lang, 'source.own')}` : '');
---
<Base lang={lang} page={page} title={page === 'home' ? t(lang, 'site.title') : t(lang, 'kpi.construction.title')}>
  {page === 'home' ? (
    <>
      <h1>{t(lang, 'site.title')}</h1>
      <p>{t(lang, 'home.purpose')}</p>
      <p><a href={href('construction', lang)}>{t(lang, 'home.card.link', { kpi: s.title[lang], value: fmt(lang, last.value, { maximumFractionDigits: 2 }), period: String(last.year) })}</a></p>
    </>
  ) : (
    <>
      <h1>{t(lang, 'kpi.construction.title')}</h1>
      <figure>
        <h2>{s.title[lang]}</h2>
        <Fragment set:html={lineChart(s, lang)} />
        {notes(s, lang).map((n) => <p class="note">{n}</p>)}
        <figcaption set:html={sourceLine} />
      </figure>
    </>
  )}
</Base>
