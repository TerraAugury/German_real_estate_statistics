---
import Base from '../../layouts/Base.astro';
import { built, langs, slug, href, type Lang, type BuiltPage } from '../../lib/routes';
import { t, fmt } from '../../lib/i18n';
import { loadSeries, annualPoints, type Series } from '../../lib/series';
import { lineChart } from '../../lib/chart';
import { kpiNotes } from '../../lib/notes';
import { loadManifest, publicLinks } from '../../lib/manifest';
import { sourcesTable } from '../../lib/sources';
import { linkPanel, sourceLine } from '../../lib/panel';
import { KPIS, CITY_CLASSES, isLand, liveViews } from '../../lib/kpis';

export function getStaticPaths() {
  return langs.flatMap((lang) => built.map((page) => ({ params: { lang, slug: slug(page, lang) || undefined }, props: { page } })));
}
const { lang } = Astro.params as { lang: Lang };
const { page } = Astro.props as { page: BuiltPage };
const s = loadSeries('construction-permits-office');
// Construction page Links; the provisional gate drops any whose series is excluded.
const links = publicLinks([{ kpi: s.key, indicator: 'euribor-3m' }, { kpi: s.key, indicator: 'cpi' }]);
const panels = page === 'construction' ? links.map((l) => linkPanel(s, loadSeries(l.indicator), lang)) : [];
const last = annualPoints(s).at(-1)!;

// KPI page: every selector state rendered, the script shows the one the URL asks for (spec section 8).
const kpi = KPIS.find((k) => k.page === page);
const views = kpi ? liveViews(kpi) : [];
const cache = new Map<string, Series>();
const series = (key: string, land?: string) => {
  const id = `${key}@${land ?? ''}`;
  if (!cache.has(id)) cache.set(id, loadSeries(key, undefined, land));
  return cache.get(id)!;
};
const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const geos = uniq(views.map((v) => v.geo));
const geoGroups = [
  { label: null, geos: geos.filter((g) => !CITY_CLASSES.includes(g) && !isLand(g)) },
  { label: t(lang, 'select.city_classes'), geos: geos.filter((g) => CITY_CLASSES.includes(g)) },
  { label: t(lang, 'select.laender'), geos: geos.filter(isLand) },
].filter((g) => g.geos.length);
const title = kpi ? t(lang, kpi.title) : t(lang, page === 'home' ? 'site.title' : 'sources.title');
---
<Base lang={lang} page={page} title={title}>
  {page === 'home' ? (
    <>
      <h1>{t(lang, 'site.title')}</h1>
      <p>{t(lang, 'home.purpose')}</p>
      <p><a href={href('construction', lang)}>{t(lang, 'home.card.link', { kpi: s.title[lang], value: fmt(lang, last.value, { maximumFractionDigits: 2 }), period: String(last.year) })}</a></p>
    </>
  ) : page === 'sources' ? (
    <>
      <h1>{title}</h1>
      <p>{t(lang, 'sources.intro')}</p>
      <Fragment set:html={sourcesTable(loadManifest(), lang)} />
    </>
  ) : (
    <>
      <h1>{title}</h1>
      {views.length === 0 ? <p class="na">{t(lang, 'kpi.not_available.licence')}</p> : (
        <>
          {/* Without JavaScript the selectors cannot switch views: hide them and say so. */}
          <noscript><style>.selectors { display: none; }</style><p class="note">{t(lang, 'kpi.noscript')}</p></noscript>
          <form class="selectors">
            <label>{t(lang, 'select.segment')} <select name="segment">{uniq(views.map((v) => v.segment)).map((x) => <option value={x}>{t(lang, `segment.${x}`)}</option>)}</select></label>
            <label>{t(lang, 'select.geo')} <select name="geo">{geoGroups.map((g) => {
              const opts = g.geos.map((x) => <option value={x}>{t(lang, `geo.${x}`)}</option>);
              return g.label ? <optgroup label={g.label}>{opts}</optgroup> : opts;
            })}</select></label>
            <label>{t(lang, 'select.freq')} <select name="freq">{uniq(views.map((v) => v.freq)).map((x) => <option value={x}>{t(lang, `freq.${x}`)}</option>)}</select></label>
          </form>
          {views.map((v, i) => (
            <section class="view" data-segment={v.segment} data-geo={v.geo} data-freq={v.freq} hidden={i > 0}>
              {v.series.map((r) => series(r.key, r.land)).map((x) => (
                <figure>
                  <h2>{x.title[lang]}</h2>
                  <Fragment set:html={lineChart(x, lang)} />
                  {kpiNotes(x, lang, t(lang, `geo.${v.geo}`)).map((n) => <p class="note">{n}</p>)}
                  <figcaption set:html={sourceLine(x, lang)} />
                </figure>
              ))}
            </section>
          ))}
          <script>
            import { pickView, type Want } from '../../lib/select';
            const form = document.querySelector<HTMLFormElement>('form.selectors')!;
            const views = [...document.querySelectorAll<HTMLElement>('section.view')].map((el) => ({ el, ...(el.dataset as Want) }));
            const keys = ['segment', 'geo', 'freq'] as const;
            // Show the closest view; the URL and the language switch then name exactly that view.
            const show = (want: Partial<Want>, changed?: keyof Want) => {
              const v = pickView(views, want, changed);
              for (const x of views) x.el.hidden = x !== v;
              for (const k of keys) (form.elements.namedItem(k) as HTMLSelectElement).value = v[k];
              history.replaceState(null, '', '?' + new URLSearchParams({ segment: v.segment, geo: v.geo, freq: v.freq }));
              document.querySelector<HTMLAnchorElement>('a.sw')!.search = location.search;
            };
            const q = new URLSearchParams(location.search);
            if (keys.some((k) => q.has(k))) show(Object.fromEntries(keys.flatMap((k) => (q.has(k) ? [[k, q.get(k)!]] : []))));
            form.addEventListener('change', (e) => show(Object.fromEntries(new FormData(form)) as Want, (e.target as HTMLSelectElement).name as keyof Want));
          </script>
        </>
      )}
      {panels.map((p) => <Fragment set:html={p} />)}
    </>
  )}
</Base>
