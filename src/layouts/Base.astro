---
import { t, documentTitle } from '../lib/i18n';
import { href, otherLang, type Lang, type PageKey } from '../lib/routes';
import { KPIS, SEGMENT_PAGES } from '../lib/kpis';
import { rootCss } from '../lib/palette';
// Self-hosted through the build: no request to a third-party host (spec section 7).
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans-condensed/400.css';
import '@fontsource/ibm-plex-sans-condensed/500.css';
import '@fontsource/ibm-plex-mono/400.css';
const { lang, page, title } = Astro.props as { lang: Lang; page: PageKey; title: string };
const current = (p: PageKey) => (p === page ? 'page' : undefined);
const inSegments = page.startsWith('segment-');
const inKpis = KPIS.some((k) => k.page === page);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light dark" />
    <title>{documentTitle(lang, page, title)}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Colours come from src/lib/palette.ts, the same module the build-time charts read. -->
    <style is:inline set:html={rootCss()}></style>
    <style is:global>
      :root {
        /* One heading scale: page title, section, plate, sub-heading; step-4 is the large headline number. */
        --step-4: 2.5rem; --step-3: 2.25rem; --step-2: 1.6rem; --step-1: 1.3rem; --step-0: 1rem;
        --sans: 'IBM Plex Sans', system-ui, sans-serif; --cond: 'IBM Plex Sans Condensed', var(--sans); --mono: 'IBM Plex Mono', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--page); color: var(--ink); font: 17px/1.55 var(--sans); }
      a { color: var(--data); text-underline-offset: 3px; text-decoration-thickness: 1px; } a:hover { color: var(--ink); }
      :focus-visible { outline: 3px solid var(--data); outline-offset: 2px; }
      .wrap { max-width: 62.5rem; margin: 0 auto; padding: 0 1.5rem; }
      @media (max-width: 560px) { .wrap { padding: 0 1rem; } body { font-size: 16px; } :root { --step-3: 1.85rem; --step-2: 1.35rem; --step-1: 1.2rem; } }

      header.site { background: var(--plate); border-bottom: 1px solid var(--rule); }
      .masthead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; padding-top: 1.25rem; }
      .masthead .name { color: var(--ink); text-decoration: none; font-weight: 600; }
      nav.main { display: flex; flex-wrap: wrap; gap: 0 1.5rem; position: relative; }
      nav.main > a, nav.main summary { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px; padding: .85rem 0; cursor: pointer; display: block; }
      nav.main > a[aria-current], nav.main .on > summary { box-shadow: inset 0 -2px 0 var(--data); }
      nav.main details { position: relative; }
      nav.main details > div { position: absolute; z-index: 10; top: 100%; left: -1rem; min-width: 18rem; max-width: calc(100vw - 2rem); background: var(--plate); border: 1px solid var(--rule); border-radius: 6px; padding: .5rem 0; box-shadow: 0 6px 20px var(--shadow); }
      nav.main details > div a { display: block; padding: .5rem 1rem; color: var(--ink); text-decoration: none; font-size: 15px; }
      nav.main details > div a.hint { color: var(--muted); font-size: 14px; border-top: 1px solid var(--hair); margin-top: .25rem; padding-top: .75rem; }
      nav.main details > div a:hover, nav.main details > div a[aria-current] { background: var(--page); }
      /* Phone: one masthead row (name, language, Menu); with JavaScript the nav is a panel under it that opens from Menu and lists
         its groups inline. Without JavaScript the nav stays visible and wraps. */
      .menu-btn { display: none; min-height: 44px; padding: 0 .85rem; font: 500 15px var(--sans); color: var(--ink); background: var(--plate); border: 1px solid var(--field); border-radius: 4px; cursor: pointer; }
      @media (max-width: 560px) {
        header.site { position: relative; }
        .masthead { flex-wrap: nowrap; align-items: center; gap: .5rem .75rem; padding-top: .5rem; padding-bottom: .5rem; }
        .masthead .name { flex: 1 1 auto; min-width: 0; font-size: 15px; line-height: 1.25; }
        .masthead .sw { font-size: 14px; }
        html.js .menu-btn { display: inline-block; }
        html.js nav.main { display: none; position: absolute; z-index: 20; left: 0; right: 0; top: 100%; flex-direction: column; background: var(--plate); border-bottom: 1px solid var(--rule); box-shadow: 0 6px 20px var(--shadow); padding-top: .25rem; padding-bottom: .5rem; }
        html.js nav.main.open { display: flex; }
        html.js nav.main > a, html.js nav.main summary { padding: .75rem 0; border-bottom: 1px solid var(--hair); }
        html.js nav.main details > div { position: static; min-width: 0; max-width: none; border: 0; border-radius: 0; box-shadow: none; padding: 0 0 0 1rem; }
        nav.main details { position: static; } nav.main details > div { left: 1rem; right: 1rem; min-width: 0; }
      }

      main { padding-top: 1.5rem; padding-bottom: 4rem; }
      /* Long German compounds (Gewerbeimmobilienmarkt, Transaktionsvolumenindex) must break at 320 px instead of widening the page. */
      h1, h2, h3, .masthead .name { overflow-wrap: break-word; hyphens: auto; }
      h1 { margin: 0 0 .5rem; font-size: var(--step-3); line-height: 1.15; font-weight: 600; letter-spacing: -.015em; }
      h2 { font-size: var(--step-2); line-height: 1.2; font-weight: 600; margin: 3rem 0 .75rem; }
      h3 { font-size: var(--step-1); line-height: 1.3; font-weight: 600; margin: 0 0 .25rem; }
      main > p, main > section > p { max-width: 40em; color: var(--muted); }
      nav.crumbs { font-size: 14px; color: var(--muted); margin-bottom: .75rem; }

      /* Plate: the chart, its notes and its source line, so a screenshot keeps them together. */
      figure { background: var(--plate); border: 1px solid var(--rule); border-radius: 6px; padding: 1.5rem 2rem 1.25rem; margin: 0 0 2rem; }
      figure h2, figure h3 { margin: 0 0 1rem; font-size: var(--step-1); }
      @media (max-width: 560px) { figure { padding: 1.25rem 1rem 1rem; } }
      .method-fig { margin: 1rem 0 1.5rem; }
      .method-fig figcaption { margin-top: .75rem; font-size: 15px; color: var(--muted); }
      .method-fig .note { font-size: 14px; }
      .method-fig .insight-grid { margin-bottom: 0; }
      table.matrix.mini td.lagcell a { display: block; }
      table.matrix.mini { width: 100%; }
      figure svg { display: block; max-width: 100%; height: auto; overflow: visible; }
      /* Wide (720) or narrow (320) chart by the width of its own box, so 13 px axis text never shows below 11 px.
         The narrow one stretches up to 28rem, which keeps its text under about 18 px. */
      figure { container-type: inline-size; }
      svg.narrow { display: none; width: 100%; max-width: 28rem; }
      @container (max-width: 639px) { svg.wide { display: none; } svg.narrow { display: block; } }
      figcaption { margin-top: 1.25rem; padding-top: .75rem; border-top: 1px solid var(--hair); font-size: 13px; line-height: 1.55; color: var(--muted); }
      /* Source footer, two tiers: a short citation, then the lineage in a closed disclosure. */
      .cite { display: inline; }
      details.lineage { margin-top: .4rem; }
      details.lineage > summary { cursor: pointer; color: var(--data); display: inline-block; padding: .25rem 0; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      details.lineage > summary:hover { color: var(--ink); }
      .lineage-item { display: block; margin: .5rem 0 0; }
      .chip { display: inline-block; border: 1px solid var(--strong-text); color: var(--strong-text); border-radius: 999px; padding: 0 .55rem; font-size: 12px; font-weight: 500; line-height: 1.5; vertical-align: 1px; }
      a[href*='db.nomics.world'], a[href*='genesis.destatis.de'], a[href*='api.statistiken.bundesbank.de'] { font-family: var(--mono); font-size: 12px; overflow-wrap: anywhere; }
      .note { font-size: 15px; margin: 1rem 0 0; max-width: 46em; }
      nav.jump h2 { font-size: var(--step-0); margin: 1.25rem 0 .75rem; }
      /* Insights index: one tile per Insight; the tile is the link, so the whole of it is the target. */
      .insight-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
      .insight-grid a { display: flex; flex-direction: column; justify-content: space-between; gap: .75rem; height: 100%; padding: 1rem 1.25rem; background: var(--plate); border: 1px solid var(--rule); border-radius: 6px; color: var(--ink); text-decoration: none; }
      .insight-grid a:hover { border-color: var(--data); }
      .insight-grid .title { font-weight: 500; line-height: 1.3; }
      .insight-grid .headline { margin: 0; }
      .insight-grid .num { font-size: var(--step-2); }
      .insight .when, .hero .when { color: var(--muted); font-size: 14px; }
      .insight-grid .when { color: var(--muted); font-size: 14px; margin-top: -.5rem; }
      .insight-grid .na { color: var(--muted); font-size: 14px; }
      section.insight { margin-top: 2.5rem; scroll-margin-top: 1rem; }
      .insight .headline, .hero .headline, .insight-grid .headline { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; margin: .25rem 0; }
      .num { font-size: var(--step-4); font-weight: 600; line-height: 1.1; color: var(--data); font-variant-numeric: tabular-nums; }
      /* A plate's lead: the latest value in Condensed numerals, then its unit, period and neutral change. */
      .latest { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .75rem; margin: 0 0 1rem; max-width: none; color: var(--ink); }
      .latest .num { font-family: var(--cond); font-weight: 500; }
      .latest .unit, .latest .when { color: var(--muted); }
      .latest .delta { font-size: 15px; font-variant-numeric: tabular-nums; }
      .insight .multiples { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--hair); } .insight .multiples h3 { font-size: var(--step-0); margin: 0 0 .25rem; }
      .insight .unit, .hero .unit, .insight-grid .unit { color: var(--muted); }
      .insight .tag, .hero .tag, .insight-grid .tag { border: 1px solid var(--rule); border-radius: 999px; padding: .1rem .75rem; font-size: 15px; background: var(--plate); }
      /* Insight tone: a light tint of the whole plate (tile, section, Home lead); the word for it is visually hidden. */
      .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .insight-grid a.tone-better, section.tone-better { background: var(--better-tint); }
      .insight-grid a.tone-worse, section.tone-worse { background: var(--worse-tint); }
      section.tone-better, section.tone-worse { padding: 1.25rem 1.5rem; border-radius: 6px; }
      section.tone-better > h2:first-child, section.tone-worse > h2:first-child { margin-top: 0; }
      @media (max-width: 560px) { section.tone-better, section.tone-worse { padding: 1rem; } }
      p.definition { font-size: 15px; margin-top: .25rem; }
      p.back { font-size: 14px; margin: 0 0 .5rem; }
      .link-panel > p { font-size: 15px; max-width: 46em; }
      .link-panel > svg { margin-top: 1.25rem; }

      /* Home hero: the lead Insight, the only headline number above the fold. */
      .hero { margin-top: 2rem; }
      .hero h2 { margin: 0 0 .5rem; }
      .hero figure { margin-top: 1rem; }
      /* Home: one row per KPI; name and what it measures, latest value and change, sparkline, then Notes and citation. */
      .index { list-style: none; margin: 2rem 0 0; padding: 0; background: var(--plate); border: 1px solid var(--rule); border-radius: 6px; }
      .index .row { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr) auto; grid-template-areas: 'name value spark' 'what value spark' 'def value spark' 'extra extra extra'; gap: .1rem 1.5rem; align-items: center; padding: 1rem 1.5rem; border-top: 1px solid var(--hair); }
      .index .row:first-child { border-top: 0; }
      .index .name { grid-area: name; align-self: end; font-size: var(--step-1); font-weight: 600; }
      .index .what { grid-area: what; align-self: start; color: var(--muted); font-size: 14px; }
      .index .definition { grid-area: def; align-self: start; margin: .35rem 0 .5rem; color: var(--muted); font-size: 14px; max-width: 40em; }
      .index .latest { grid-area: value; margin: 0; }
      .index .latest .num { font-size: var(--step-2); }
      .index svg { grid-area: spark; display: block; }
      .index .note, .index .src, .index .na { grid-area: auto; grid-column: 1 / -1; margin: .5rem 0 0; font-size: 13px; color: var(--muted); }
      .index .na { grid-column: 1 / -1; font-size: 15px; }
      @media (max-width: 720px) { .index .row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'name name' 'what what' 'def def' 'value spark' 'extra extra'; padding: 1rem; } }

      .selectors { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; margin: 1.25rem 0 1.75rem; }
      .selectors label, .selectors .lagfield { display: flex; flex-direction: column; gap: .4rem; font-size: 14px; font-weight: 500; color: var(--muted); }
      .selectors select { min-height: 44px; min-width: 11rem; max-width: 100%; padding: 0 .75rem; font: 16px var(--sans); color: var(--ink); background: var(--plate); border: 1px solid var(--field); border-radius: 4px; }
      .lagtitle { position: relative; display: flex; align-items: center; gap: .5rem; }
      .help { width: 22px; height: 22px; padding: 0; border-radius: 50%; border: 1px solid var(--muted); background: transparent; color: var(--muted); font: 600 13px/1 var(--sans); cursor: help; }
      .tip { display: none; position: absolute; z-index: 5; top: calc(100% + .4rem); left: 0; width: min(24rem, 86vw); padding: .6rem .75rem; font-size: 14px; font-weight: 400; line-height: 1.4; color: var(--ink); background: var(--plate); border: 1px solid var(--muted); border-radius: 6px; }
      .help:hover + .tip, .help:focus + .tip { display: block; }
      @media (max-width: 560px) { .selectors label { flex: 1 1 100%; min-width: 0; } .selectors select { width: 100%; min-width: 0; } }

      .scroll { overflow-x: auto; }
      table { border-collapse: separate; border-spacing: 4px; font-size: 15px; line-height: 1.35; margin: 0 -4px; }
      /* A table written in a prose page (the Methodology direction table): long German words wrap instead of widening the page. */
      main > table { width: 100%; } main > table th, main > table td { overflow-wrap: anywhere; hyphens: auto; }
      th, td { text-align: left; vertical-align: top; padding: .65rem .75rem; }
      thead th { font: 500 14px/1.2 var(--cond); color: var(--muted); border-bottom: 2px solid var(--ink); }
      tbody th { font-weight: 500; padding-left: 0; }
      td { background: var(--plate); border: 1px solid var(--rule); border-radius: 4px; font-variant-numeric: tabular-nums; }
      td.yes { background: var(--yes); border-color: var(--yes-rule); } td.yes a { font-weight: 500; }
      td.na, .na { color: var(--muted); background: repeating-linear-gradient(135deg, var(--na) 0 6px, var(--page) 6px 12px); border-color: transparent; }
      td.licence { background: var(--plate); }
      /* Links overview: a shown Link is shaded by its rank correlation (src/lib/heat.ts); ink on every shade is 4.5:1 or better. */
      /* Each cell holds one link per lag (ticket 10); the table's data-lag shows the selected one, or the pre-set link of each box (data-pre) for 'p', the opening choice. */
      html:not(.js) .lag-selector { display: none; } /* the selector needs script; without it the matrix shows the pre-sets */
      td.lagcell { padding: 0; height: 1px; } /* 1px lets the link fill the cell's full row height */
      td.lagcell a { display: none; box-sizing: border-box; height: 100%; padding: .65rem .75rem; color: var(--ink); }
      table.matrix[data-lag="p"] a[data-pre], table.matrix[data-lag="0"] a[data-lag="0"], table.matrix[data-lag="1"] a[data-lag="1"], table.matrix[data-lag="2"] a[data-lag="2"] { display: block; }
      td.lagcell a.zero { background: var(--plate); }
      td.lagcell a.neg { background: color-mix(in srgb, var(--heat-neg) var(--share), var(--plate)); }
      td.lagcell a.pos { background: color-mix(in srgb, var(--heat-pos) var(--share), var(--plate)); }
      td.lagcell a.noise { background: color-mix(in srgb, var(--muted) 14%, var(--plate)); }
      td.lagcell a.na { color: var(--muted); background: repeating-linear-gradient(135deg, var(--na) 0 6px, var(--page) 6px 12px); }
      td.lagcell .rho { display: block; font: 600 17px/1.25 var(--cond); font-variant-numeric: tabular-nums; white-space: nowrap; }
      td.lagcell .n { display: block; font-size: 13px; white-space: nowrap; }
      td.lagcell .preset { display: none; } table.matrix[data-lag="p"] td.lagcell .preset { display: block; font-size: 12px; font-weight: 500; white-space: nowrap; border-top: 1px dashed currentColor; margin-top: .25rem; padding-top: .15rem; }
      table.matrix td { min-width: 5.5rem; }
      table.matrix tbody th { min-width: 8rem; max-width: 11rem; }
      table.matrix th:first-child { position: sticky; left: 0; z-index: 1; background: var(--page); }
      table.matrix tbody th small { font-weight: 400; color: var(--muted); }
      @media (max-width: 560px) { table.matrix tbody th { min-width: 6.5rem; max-width: 7.5rem; font-size: 14px; } }
      .legend { display: flex; align-items: center; gap: .5rem; margin: 1rem 0 .25rem; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
      .legend .ramp { flex: 0 1 22rem; height: .75rem; border: 1px solid var(--rule); border-radius: 2px;
        background: linear-gradient(90deg, color-mix(in srgb, var(--heat-neg) var(--heat-max), var(--plate)), var(--plate), color-mix(in srgb, var(--heat-pos) var(--heat-max), var(--plate))); }
      .scale { display: flex; justify-content: space-between; gap: .25rem 1rem; flex-wrap: wrap; max-width: 22rem; margin: 0 0 .75rem; font-size: 13px; color: var(--muted); }
      td:empty { background: none; border-color: transparent; } /* Links overview: no such pair */
      p.na { padding: .5rem .75rem; border-radius: 4px; }

      footer.site { background: var(--plate); border-top: 1px solid var(--rule); }
      footer.site .wrap { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-top: 1.5rem; padding-bottom: 2rem; font-size: 14px; color: var(--muted); }
      footer.site span { margin-right: auto; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap masthead">
        <a class="name" href={href('home', lang)}>{t(lang, 'site.title')}</a>
        <a class="sw" href={href(page, otherLang(lang))} hreflang={otherLang(lang)}>{t(lang, 'lang.switch')}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">{t(lang, 'nav.menu')}</button>
      </div>
      <nav class="wrap main" id="site-nav">
        <a href={href('home', lang)} aria-current={current('home')}>{t(lang, 'nav.home')}</a>
        <details class={inSegments ? 'on' : undefined}><summary>{t(lang, 'nav.segments')}</summary><div>{SEGMENT_PAGES.map((g) => <a href={href(`segment-${g}`, lang)} aria-current={current(`segment-${g}`)}>{t(lang, `segment.${g}`)}</a>)}<a class="hint" href={href('availability', lang)}>{t(lang, 'nav.logistics')}</a></div></details>
        <details class={inKpis ? 'on' : undefined}><summary>{t(lang, 'nav.kpis')}</summary><div>{KPIS.map((k) => <a href={href(k.page, lang)} aria-current={current(k.page)}>{t(lang, k.title)}</a>)}</div></details>
        <a href={href('links', lang)} aria-current={current('links')}>{t(lang, 'nav.links')}</a>
        <a href={href('insights', lang)} aria-current={current('insights')}>{t(lang, 'nav.insights')}</a>
        <a href={href('availability', lang)} aria-current={current('availability')}>{t(lang, 'nav.availability')}</a>
        <a href={href('methodology', lang)} aria-current={current('methodology')}>{t(lang, 'nav.methodology')}</a>
      </nav>
    </header>
    <!-- The language switch keeps the selector parameters (segment, geo, freq) unchanged; KPI pages update it on change. -->
    <!-- One dropdown open at a time: a click or focus elsewhere closes it, Escape closes it and returns to its summary. On a phone the same goes for the Menu panel. -->
    <script is:inline>
      document.querySelector('a.sw').search = location.search;
      {
        const menus = [...document.querySelectorAll('nav.main details')];
        const nav = document.querySelector('nav.main'), btn = document.querySelector('.menu-btn');
        const setMenu = (on) => { nav.classList.toggle('open', on); btn.setAttribute('aria-expanded', String(on)); };
        btn.addEventListener('click', () => setMenu(!nav.classList.contains('open')));
        const closeOutside = (e) => {
          for (const d of menus) if (!d.contains(e.target)) d.open = false;
          if (!nav.contains(e.target) && !btn.contains(e.target)) setMenu(false);
        };
        document.addEventListener('click', closeOutside);
        document.addEventListener('focusin', closeOutside);
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const d = menus.find((m) => m.open);
          if (d) { d.open = false; d.querySelector('summary').focus(); }
          else if (nav.classList.contains('open')) { setMenu(false); btn.focus(); }
        });
      }
    </script>
    <main class="wrap"><slot /></main>
    <footer class="site"><div class="wrap"><span>{t(lang, 'footer.text')}</span><a href={href('availability', lang)}>{t(lang, 'nav.availability')}</a><a href={href('sources', lang)}>{t(lang, 'nav.sources')}</a>{(['about', 'terms', 'privacy', 'legal-notice'] as const).map((k) => <a href={href(k, lang)}>{t(lang, `${k}.title`)}</a>)}</div></footer>
  </body>
</html>
