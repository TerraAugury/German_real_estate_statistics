---
// One Link panel of a KPI page. `order` is its place among all the page's panels, so the script can insert a fetched one in order.
import { getSeries } from '../lib/series';
import { linkPanel } from '../lib/panel';
import { t } from '../lib/i18n';
import type { KpiPage } from '../lib/pages';
import type { Lang } from '../lib/routes';
const { panel: p, order, lang } = Astro.props as { panel: KpiPage['panels'][number]; order: number; lang: Lang };
const html = linkPanel(getSeries(p.pair.kpi, p.pair.land), getSeries(p.pair.indicator), lang, t(lang, `geo.${p.geo}`), p.id);
---
<div data-panel={p.id} data-order={order}><Fragment set:html={html} /></div>
