---
// One Link panel of a KPI page. `order` is its place among all the page's panels, so the script can insert a fetched one in order.
import { getSeries } from '../lib/series';
import { linkPanel } from '../lib/panel';
import { t } from '../lib/i18n';
import type { KpiPage } from '../lib/pages';
import type { Lang } from '../lib/routes';
const { panel: p, order, lang, page } = Astro.props as { panel: KpiPage['panels'][number]; order: number; lang: Lang; page: string };
const html = linkPanel(getSeries(p.pair.kpi, p.pair.land), getSeries(p.pair.indicator), lang, t(lang, `geo.${p.geo}`), p.id, p.pair.preset, `/${lang}/fragments/full/${page}/${p.id}/`);
---
<div data-panel={p.id} data-order={order}><Fragment set:html={html} /></div>

<script>
  // A panel whose two series cover different periods opens on the period both cover; its full-history chart is fetched the first time it is picked.
  document.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    if (input.type !== 'radio' || input.value !== 'full' || !input.checked) return;
    const box = input.closest('.overlay')?.querySelector<HTMLElement>('.view-full');
    const src = box?.dataset.src;
    if (!box || !src) return;
    delete box.dataset.src;
    try { const res = await fetch(src);
      if (!res.ok) throw new Error(String(res.status));
      box.innerHTML = await res.text(); } catch { box.dataset.src = src; }
  });
</script>
